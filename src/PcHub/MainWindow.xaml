<Window x:Class="PcHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PcHub.Controls"
        xmlns:vm="clr-namespace:PcHub.ViewModels"
        Title="PCHUB"
        Width="1240" Height="820" MinWidth="820" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <c:GroupNameConverter x:Key="GroupName" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadToolsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid Margin="20,16,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PCHUB" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="13">
                        <Run Text="{Binding GpuName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  ·  " Foreground="{StaticResource Muted}" />
                        <Run Text="{Binding GpuDetail, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                    </TextBlock>
                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Accent}" Text="{Binding CompactStats}"
                               Visibility="{Binding ShowCompactStats, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding FreeGpuCommand}" Padding="18,9" FontSize="14"
                            AutomationProperties.Name="Free the GPU"
                            ToolTip="Close your AI apps and unload Ollama models to give the VRAM back (asks first)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,8 L6,12 L14,3" Stroke="#0B1A10" StrokeThickness="2.2" Margin="0,1,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Free the GPU" Foreground="#0B1A10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding FreeStatus}" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="0,6,0,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- Tabs: Dashboard + apps opened inside PCHUB -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Command="{Binding ShowDashboardCommand}" Padding="14,6" Margin="0,0,6,0" x:Name="DashTab" Content="Dashboard">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDashboard}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding ShowStoreCommand}" Padding="14,6" Margin="0,0,6,0" Content="Get apps"
                        ToolTip="Find image, video and chat apps online">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStore}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ItemsControl ItemsSource="{Binding WebTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WebTabViewModel}">
                            <Border x:Name="TabBorder" Margin="0,0,6,0" CornerRadius="6" BorderThickness="1"
                                    Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" x:Name="TabButton" Padding="12,6" FontSize="13"
                                            Foreground="{StaticResource Text}" MaxWidth="260" AutomationProperties.Name="{Binding Title}"
                                            ToolTip="{Binding Title}"
                                            Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <!-- TextBlock, not plain content: plain button text treats "_" as a shortcut marker and hides it -->
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <Button Content="✕" Style="{StaticResource GhostButton}" Padding="6,4" Margin="0,0,4,0" FontSize="11"
                                            AutomationProperties.Name="Close tab" ToolTip="Close this tab (the app keeps running)"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="TabButton" Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- GPU note (e.g. AMD/Intel: no temperature) -->
            <Border Grid.Row="2" Margin="0,0,0,12" Padding="12,8" CornerRadius="8" Background="#2A2412" BorderBrush="#4A3B12" BorderThickness="1"
                    Visibility="{Binding ShowGpuNote, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding GpuNote}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <!-- Stat tiles -->
            <UniformGrid Grid.Row="3" Rows="1" Columns="4" Margin="-6,0,-6,14" Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="52" /></Grid.RowDefinitions>
                        <TextBlock Text="VRAM" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Margin="0,2,0,0">
                            <Run Text="{Binding VramUsed, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                            <Run Text=" GB" Foreground="{StaticResource Muted}" FontSize="14" />
                        </TextBlock>
                        <Grid Grid.Row="2" Margin="0,4,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding VramPercent, Mode=OneWay}" Foreground="{StaticResource Accent}"
                                         Background="{StaticResource Surface2}" BorderThickness="0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding VramTotal}" Style="{StaticResource Label}" Margin="10,0,0,0" />
                        </Grid>
                        <c:Sparkline Grid.Row="3" Series="{Binding VramSeries}" Maximum="100" Stroke="{StaticResource Accent}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="52" /></Grid.RowDefinitions>
                        <TextBlock Text="GPU load" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Margin="0,2,0,0" Text="{Binding Load}" Style="{StaticResource BigValue}" />
                        <TextBlock Grid.Row="2" Text="busiest engine" Style="{StaticResource Label}" Margin="0,4,0,6" />
                        <c:Sparkline Grid.Row="3" Series="{Binding LoadSeries}" Maximum="100" Stroke="{StaticResource Info}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="52" /></Grid.RowDefinitions>
                        <TextBlock Text="Temperature" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Margin="0,2,0,0" Text="{Binding Temp}" Style="{StaticResource BigValue}" />
                        <TextBlock Grid.Row="2" Text="{Binding TempSub}" Style="{StaticResource Label}" Margin="0,4,0,6" />
                        <c:Sparkline Grid.Row="3" Series="{Binding TempSeries}" Maximum="100" Stroke="{StaticResource Warn}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="52" /></Grid.RowDefinitions>
                        <TextBlock Text="Power" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Margin="0,2,0,0" Text="{Binding Power}" Style="{StaticResource BigValue}" />
                        <TextBlock Grid.Row="2" Text="{Binding PowerSub}" Style="{StaticResource Label}" Margin="0,4,0,6" TextTrimming="CharacterEllipsis" />
                        <c:Sparkline Grid.Row="3" Series="{Binding PowerSeries}" Maximum="{Binding PowerMax}" Stroke="{StaticResource Violet}" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Main area: apps (left) and processes + history (right) -->
            <Grid Grid.Row="4" Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" MinWidth="380" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Left column: apps on top, drives & fragmentation below -->
                <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Apps -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10" LastChildFill="False">
                            <TextBlock Text="Your AI apps" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Add app" Command="{Binding AddAppCommand}" Margin="0,0,6,0" ToolTip="Add any program PCHUB didn't find" />
                                <Button Content="Find apps" Command="{Binding RescanCommand}" Margin="0,0,6,0"
                                        ToolTip="Look for common AI apps on this PC. You choose which ones to add." />
                                <Button Content="Edit list" Command="{Binding EditToolsCommand}" Style="{StaticResource GhostButton}" ToolTip="Open tools.json (ports, arguments, folders)" />
                                <Button Content="Reload" Command="{Binding ReloadToolsCommand}" Style="{StaticResource GhostButton}" ToolTip="Reload tools.json (F5)" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Find apps results: opt-in, nothing is added until the user ticks and confirms -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="14,12" CornerRadius="8" Background="{StaticResource Surface2}"
                                BorderBrush="{StaticResource Info}" BorderThickness="1"
                                Visibility="{Binding ShowScanPanel, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ScanStatus}" FontSize="13" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,8,0,0" MaxHeight="220">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SuggestionViewModel}">
                                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" ToolTip="{Binding Location}">
                                                <TextBlock>
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Location, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11" />
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Not now" Command="{Binding DismissSuggestionsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                                    <Button Content="Add selected" Command="{Binding AddSuggestionsCommand}" Style="{StaticResource PrimaryButton}" Padding="14,5"
                                            Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="No apps added" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="PCHUB works fine without any. If you use local AI apps (ComfyUI, Ollama, LM Studio, Forge…), you can let PCHUB find them, or add one yourself."
                                           Style="{StaticResource Label}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button Content="Find my AI apps" Command="{Binding RescanCommand}" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" />
                                    <Button Content="Add app" Command="{Binding AddAppCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Tools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="310" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ToolViewModel}">
                                            <Border Margin="0,0,10,10" Padding="14,12" CornerRadius="8" Background="{StaticResource Surface2}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock DockPanel.Dock="Right" x:Name="StateLabel" Text="{Binding StateText}" FontSize="12"
                                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Location}" Margin="0,0,8,0" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="17,2,0,0" />

                                                    <UniformGrid Columns="3" Margin="0,10,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="VRAM" Style="{StaticResource Label}" FontSize="11" />
                                                            <TextBlock Text="{Binding VramText}" FontSize="13" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="GPU" Style="{StaticResource Label}" FontSize="11" />
                                                            <TextBlock Text="{Binding GpuText}" FontSize="13" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="Up" Style="{StaticResource Label}" FontSize="11" />
                                                            <TextBlock Text="{Binding UptimeText}" FontSize="13" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                                                    <WrapPanel Margin="0,12,0,0">
                                                        <Button Content="Start" Style="{StaticResource PrimaryButton}" Padding="14,5" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Stop" Padding="14,5" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Open" Style="{StaticResource GhostButton}" ToolTip="Open inside PCHUB"
                                                                Command="{Binding DataContext.OpenInAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Log" Style="{StaticResource GhostButton}"
                                                                Command="{Binding DataContext.OpenLogCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Folder" Style="{StaticResource GhostButton}"
                                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Content="Remove" Style="{StaticResource GhostButton}" ToolTip="Remove from this list (nothing is deleted)"
                                                                Command="{Binding DataContext.RemoveToolCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Ready">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Running">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Starting">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Warn}" />
                                                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource Warn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Stopping">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Warn}" />
                                                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource Warn}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Drives & fragmentation -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10" LastChildFill="False">
                            <TextBlock Text="Drives &amp; fragmentation" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Optimize drives…" Command="{Binding OptimizeDrivesCommand}" Margin="0,0,6,0"
                                        ToolTip="Open Windows' Optimize Drives to analyse or defragment (asks for admin itself)" />
                                <Button Content="Refresh" Command="{Binding RefreshDrivesCommand}" Style="{StaticResource GhostButton}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Label}" FontSize="11" Margin="2,2,0,0" TextWrapping="Wrap"
                                   Text="Blocks are drawn to scale from Windows' last drive analysis: blue = used, orange = fragmented, flat = free." />

                        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                                        <Border Width="228" Margin="0,0,10,8" Padding="12,10" CornerRadius="8" Background="{StaticResource Surface2}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="{Binding Advice}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Padding="6,1" CornerRadius="4" Background="{StaticResource Bg}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource Muted}" />
                                                    </Border>
                                                    <TextBlock FontSize="14" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Letter, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12" />
                                                    </TextBlock>
                                                </DockPanel>
                                                <c:IsoBlockMap Margin="0,2,0,8" UsedFraction="{Binding UsedFraction}"
                                                               FragmentedFraction="{Binding FragmentedFraction}" Seed="{Binding Seed}"
                                                               IsActive="{Binding IsOptimizing}" Progress="{Binding Progress}" />
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Optimize" Padding="10,3" FontSize="12" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.OptimizeDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanOptimize, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Run Windows' optimizer on this drive (asks for admin)" />
                                                    <TextBlock x:Name="Frag" Text="{Binding FragText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding StageText}" Foreground="{StaticResource Info}" FontSize="12" Margin="0,2,0,0"
                                                           Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding UsedText}" Style="{StaticResource Label}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding LastText}" Style="{StaticResource Label}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                <Setter TargetName="Frag" Property="Foreground" Value="{StaticResource Warn}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.1*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- GPU processes -->
                    <Border Style="{StaticResource Card}" Padding="14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ScanText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <TextBlock Text="Using the GPU" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="2,0,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Process" Style="{StaticResource Label}" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="VRAM" Style="{StaticResource Label}" FontSize="11" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="GPU" Style="{StaticResource Label}" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                            <ListBox ItemsSource="{Binding GpuProcesses}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="2,5" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GpuProcViewModel}">
                                        <Grid ToolTip="{Binding Path}" Margin="0,0,6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock TextTrimming="CharacterEllipsis" FontSize="13">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding Owner, Mode=OneWay}" Foreground="{StaticResource Accent}" FontSize="11" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding VramText}" FontSize="13" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding GpuText}" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" />
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="2" Margin="0,4,0,0" Minimum="0" Maximum="1"
                                                         Value="{Binding VramShare, Mode=OneWay}" Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- History -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="History" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
                            <ListBox ItemsSource="{Binding Log.Entries}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter Margin="2,3" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,6,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Label}" FontSize="11" Margin="0,1,0,0" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12">
                                                <Run x:Name="ToolRun" Text="{Binding Tool, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run x:Name="MsgRun" Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                            </TextBlock>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter TargetName="MsgRun" Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                <Setter TargetName="MsgRun" Property="Foreground" Value="{StaticResource Warn}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Get apps: built-in list + GitHub search, grouped SFW / NSFW (18+) / Not rated -->
            <Border Grid.Row="2" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="16"
                    DataContext="{Binding Store}"
                    Visibility="{Binding DataContext.IsStore, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <!-- Search row -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Search online" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}"
                                Padding="16,7" Margin="8,0,0,0" ToolTip="Search GitHub, where most local AI apps are published" />
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Search words" ToolTip="Optional words, e.g. 'anime', 'low vram', 'voice'">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <!-- Category chips, NSFW toggle, download folder -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                    <Setter Property="Padding" Value="14,5" />
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                </Style>
                            </StackPanel.Resources>
                            <Button Content="All" Command="{Binding CategoryCommand}" CommandParameter="All">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsAll}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Image" Command="{Binding CategoryCommand}" CommandParameter="Image">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Video" Command="{Binding CategoryCommand}" CommandParameter="Video">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Chat" Command="{Binding CategoryCommand}" CommandParameter="Chat">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsChat}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <CheckBox Content="Show NSFW (18+) apps" IsChecked="{Binding ShowAdult}" Margin="14,0,0,0" VerticalAlignment="Center"
                                      ToolTip="Apps with no content filter. Asks you to confirm you're 18 or older." />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360">
                                <Run Text="Downloads go to " /><Run Text="{Binding DownloadFolder, Mode=OneWay}" Foreground="{StaticResource Text}" />
                            </TextBlock>
                            <Button Content="Change…" Command="{Binding ChangeFolderCommand}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" />
                            <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Responsibility notice: always visible on this page -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="14,10" CornerRadius="8" Background="#2A2412" BorderBrush="{StaticResource Warn}" BorderThickness="1">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5">
                            <Run Text="Your responsibility: " FontWeight="SemiBold" Foreground="{StaticResource Warn}" /><Run Text="{Binding Notice, Mode=OneWay}" Foreground="{StaticResource Text}" />
                        </TextBlock>
                    </Border>

                    <!-- Optional Claude scan -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="Scan each download with Claude (safety, legal, age gate)" IsChecked="{Binding ClaudeAgeCheck}" VerticalAlignment="Center"
                                  ToolTip="Opt-in. Sends the app's README and the parts of its files that matter for safety and age-gating to Anthropic, using your own API key." />
                        <TextBlock Text="{Binding ClaudeKeyText}" Style="{StaticResource Label}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        <Button Content="Set API key…" Command="{Binding SetClaudeKeyCommand}" Style="{StaticResource GhostButton}" Margin="4,0,0,0" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Foreground="{StaticResource Info}" FontSize="12" Margin="2,0,0,8" TextWrapping="Wrap" />

                    <!-- Results: SFW (left, green) | NSFW 18+ (right, red) / Not rated (bottom, grey) -->
                    <Grid>
                        <Grid.Resources>
                            <DataTemplate x:Key="StoreItemTemplate" DataType="{x:Type vm:StoreItemViewModel}">
                                <Border Padding="14,12" CornerRadius="8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="4" Background="{StaticResource Bg}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryText}" FontSize="11" Foreground="{StaticResource Muted}" />
                                                </Border>
                                                <Border x:Name="RatingBadge" Margin="6,0,0,0" Padding="6,1" CornerRadius="4" Background="#173323" VerticalAlignment="Center">
                                                    <TextBlock x:Name="RatingLabel" Text="{Binding RatingText}" FontSize="11" Foreground="{StaticResource Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Label}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0" />
                                            <ProgressBar Height="3" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                         Foreground="{StaticResource Accent}" Background="{StaticResource Bg}" BorderThickness="0"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Info}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <Border x:Name="AgeBox" Margin="0,6,0,0" Padding="8,5" CornerRadius="5" Background="#13261B"
                                                    Visibility="{Binding HasAgeGateText, Converter={StaticResource BoolToVis}}">
                                                <TextBlock x:Name="AgeText" Text="{Binding AgeGateText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Accent}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="Download" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,0,6"
                                                    Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Cancel" Padding="16,6" Margin="0,0,0,6"
                                                    Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Show in folder" Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding HasDownloaded, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Scan with Claude" Style="{StaticResource GhostButton}"
                                                    ToolTip="Ask Claude to check this download for safety and legal red flags and an age gate (uses your API key)"
                                                    Command="{Binding DataContext.CheckAgeGateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanCheckAgeGate, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Website" Style="{StaticResource GhostButton}" ToolTip="{Binding App.Website}"
                                                    Command="{Binding DataContext.WebsiteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding App.Rating}" Value="Nsfw">
                                        <Setter TargetName="RatingBadge" Property="Background" Value="#3A1A1A" />
                                        <Setter TargetName="RatingLabel" Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AgeGateWarn}" Value="True">
                                        <Setter TargetName="AgeBox" Property="Background" Value="#2E2410" />
                                        <Setter TargetName="AgeText" Property="Foreground" Value="{StaticResource Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding App.Rating}" Value="Unrated">
                                        <Setter TargetName="RatingBadge" Property="Background" Value="{StaticResource Bg}" />
                                        <Setter TargetName="RatingLabel" Property="Foreground" Value="{StaticResource Muted}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                            <Style x:Key="StoreList" TargetType="ListBox">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                                <Setter Property="ItemTemplate" Value="{StaticResource StoreItemTemplate}" />
                                <Setter Property="ItemContainerStyle">
                                    <Setter.Value>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,0,6,8" /></ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="0.6*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- SFW -->
                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="10" Padding="12,10,6,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="2,0,0,8">
                                    <Run Text="SFW" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                    <Run Text="  content filter or safe defaults" Foreground="{StaticResource Muted}" FontSize="12" />
                                </TextBlock>
                                <ListBox ItemsSource="{Binding SfwView}" Style="{StaticResource StoreList}" AutomationProperties.Name="SFW apps" />
                            </DockPanel>
                        </Border>

                        <!-- NSFW (18+) -->
                        <Border Grid.Row="0" Grid.Column="2" BorderBrush="{StaticResource Danger}" BorderThickness="2" CornerRadius="10" Padding="12,10,6,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="2,0,0,8">
                                    <Run Text="NSFW (18+)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                                    <Run Text="  no content filter" Foreground="{StaticResource Muted}" FontSize="12" />
                                </TextBlock>
                                <Grid>
                                    <ListBox ItemsSource="{Binding NsfwView}" Style="{StaticResource StoreList}" AutomationProperties.Name="NSFW apps"
                                             Visibility="{Binding ShowNsfwList, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                                                Visibility="{Binding NsfwHidden, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Hidden" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                                   Text="These apps can make adult content. Tick &quot;Show NSFW (18+) apps&quot; above to see them; you'll be asked to confirm you're 18 or older." />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Not rated -->
                        <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{StaticResource Muted}" BorderThickness="2" CornerRadius="10" Padding="12,10,6,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="2,0,0,8">
                                    <Run Text="Not rated" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                    <Run Text="  online results PCHUB couldn't classify; check the project's page before downloading" Foreground="{StaticResource Muted}" FontSize="12" />
                                </TextBlock>
                                <Grid>
                                    <ListBox ItemsSource="{Binding UnratedView}" Style="{StaticResource StoreList}" AutomationProperties.Name="Not rated apps" />
                                    <TextBlock Text="Press Search online to find more apps; anything PCHUB can't classify shows up here."
                                               Style="{StaticResource Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding NoUnrated, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- In-app web view (ComfyUI etc.), shown instead of the dashboard -->
            <Border Grid.Row="2" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding IsWebView, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,10,10" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Reload" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                                    Command="{Binding ReloadTabCommand}" CommandParameter="{Binding SelectedTab}" />
                            <Button Content="Open in browser" Style="{StaticResource GhostButton}"
                                    ToolTip="Open this page in your default browser"
                                    Command="{Binding OpenTabInBrowserCommand}" CommandParameter="{Binding SelectedTab}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding SelectedTab.Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                            <Run Text="  " />
                            <Run Text="{Binding SelectedTab.Url, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12" />
                        </TextBlock>
                    </DockPanel>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" ClipToBounds="True" CornerRadius="0,0,10,10">
                        <Grid x:Name="WebHostGrid">
                            <!-- Shown while the app isn't ready, or when the WebView2 runtime is missing -->
                            <StackPanel x:Name="WebPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                                <StackPanel x:Name="WaitingPanel">
                                    <TextBlock Text="{Binding SelectedTab.WaitingText}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" />
                                    <Button Content="Start it" Style="{StaticResource PrimaryButton}" Padding="18,7" Margin="0,14,0,0" HorizontalAlignment="Center"
                                            Focusable="False"
                                            Command="{Binding StartTabToolCommand}" CommandParameter="{Binding SelectedTab}"
                                            Visibility="{Binding SelectedTab.CanStartTool, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel x:Name="RuntimeMissingPanel" Visibility="Collapsed">
                                    <TextBlock Text="Showing apps inside PCHUB needs Microsoft Edge WebView2" FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                               Text="It comes with Windows 11 and most Windows 10 PCs, but isn't on this one. You can install it from Microsoft (free), or open this app in your browser instead." />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                        <Button Content="Get WebView2 from Microsoft" Click="GetWebView2_Click" Margin="0,0,8,0" />
                                        <Button Content="Open in browser" Command="{Binding OpenTabInBrowserCommand}" CommandParameter="{Binding SelectedTab}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Footer -->
            <DockPanel Grid.Row="5" Margin="2,10,0,0">
                <CheckBox DockPanel.Dock="Right" Content="Low-power mode" IsChecked="{Binding LowPower}" FontSize="12"
                          ToolTip="Sample less often. Good for older PCs and laptops on battery." />
                <Button DockPanel.Dock="Right" Content="Data folder" Style="{StaticResource GhostButton}" Command="{Binding OpenDataCommand}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding DataLocation}" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <!-- Confirm overlay -->
        <Grid Background="{StaticResource Scrim}" Visibility="{Binding ConfirmOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                    <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Command="{Binding CancelConfirmCommand}" IsCancel="True" Margin="0,0,8,0" Padding="16,7" />
                        <Button Content="{Binding ConfirmButton}" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Padding="16,7" x:Name="ConfirmButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Add app overlay -->
        <Grid Background="{StaticResource Scrim}" Visibility="{Binding AddOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <StackPanel>
                    <TextBlock Text="Add an app" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                    <TextBlock Text="Any program or launcher (.exe, .bat, .cmd, .vbs). PCHUB tracks every process running from its folder."
                               Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,14" />

                    <TextBlock Text="Program" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseProgramCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding AddProgram, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding AddName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Arguments (optional)" Style="{StaticResource Label}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding AddArgs, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Port (optional)" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding AddPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="If the app serves a web page or API, its port (shows Ready when it answers)" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Web address (optional)" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding AddUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Run in the background (no window, output saved to a log)" IsChecked="{Binding AddHidden}" Margin="0,14,0,0" />

                    <TextBlock Text="{Binding AddError}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasAddError, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Command="{Binding CancelAddCommand}" Margin="0,0,8,0" Padding="16,7" />
                        <Button Content="Add" Command="{Binding SaveAddCommand}" Style="{StaticResource PrimaryButton}" Padding="20,7" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
