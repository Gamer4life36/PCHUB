<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- One cross-platform target: the same build runs on Windows and macOS (platform code is chosen at run time). -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PcHub</RootNamespace>
    <AssemblyName>PCHUB</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\pchub.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Product>PCHUB</Product>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <!-- Performance: profile-guided JIT, lean GC for a small always-on tool. -->
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1416: platform-specific calls are guarded at run time by the platform layer (OperatingSystem.IsWindows / IsMacOS). -->
    <NoWarn>$(NoWarn);CA1001;CA1031;CA1305;CA1307;CA1309;CA1310;CA1416;CA1515;CA1711;CA1716;CA1805;CA1812;CA1822;CA1848;CA2000;CA2007;CA5392</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <!-- In-app tabs: Edge WebView2 on Windows, WKWebView on macOS. MIT licensed. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.2" />
    <PackageReference Include="Anthropic" Version="13.10.0" />
    <!-- Windows-only helpers (used only when running on Windows). -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icons drawn by packaging/icon/make_icon.py -->
    <AvaloniaResource Include="Assets\pchub.ico" />
    <AvaloniaResource Include="Assets\pchub-256.png" />
  </ItemGroup>

  <!-- Release publish: precompiled native code (ReadyToRun) for fast start. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
